---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";
const blog = await getCollection("blog");
const categories = await getCollection("categories");
---

<Layout>
	<main>
		<div class="text-center">
			<div class="border-2 border-black m-4 rounded-2xl p-4 bg-[#ada3f5]">
				<h1 class="font-bold text-3xl">The New Mind</h1>
				<h2>
					This is a website where I'm going to publish a great amount of
					different kind of things which I'm interested in.
				</h2>
			</div>
			<div>
				<ul>
					{
						// blog.map((blogEntries) => (
						// 	<li>
						// 		<Link path=`/astro/${blogEntries.id}` background="bg-red-400" text={blogEntries.data.title}/>
						// 	</li>
						// ))
						categories.map((categoriesEntries) => (
							<li>
								<Link path=`/${categoriesEntries.id}` background="bg-red-400" text={categoriesEntries.data.title}/>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</main>
</Layout>
