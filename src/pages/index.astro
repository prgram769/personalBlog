---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";

const categories = await getCollection("categories");
---

<Layout title="Inicio" hidden="true">
  <main>
    <div class="text-center">
      <div class="border-2 border-black m-4 rounded-2xl p-4 bg-[#ada3f5]">
        <h1 class="font-bold text-3xl">The New Mind</h1>
        <h2>
          Esto es una pagina web donde voy a publicar mucho contenido diferente
        </h2>
      </div>
      <div>
        <ul>
          {
            categories.map((categoriesEntries) => (
              <li>
                <Link
                  path={`/${categoriesEntries.id}`}
                  background="bg-red-400"
                  text={categoriesEntries.data.title}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </main>
</Layout>
