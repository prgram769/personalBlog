---
import { render } from "astro:content";
import { getEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
const blog = await getCollection("blog");
const post = await getEntry("blog", "astroislands");
const { Content } = await render(post);
---

<Layout>
	<main>
		<div class="text-center">
			<div class="border-2 border-black m-2 rounded-2xl p-4 bg-[#ada3f5]">
				<h1 class="font-bold text-3xl">The New Mind</h1>
				<h2>
					This is a website where I'm going to publish a great amount of
					different kind of things which I'm interested in.
				</h2>
			</div>
			<div>
				<ul>
					{
						blog.map((blogEntries) => (
							<li>
								<a href={`/${blogEntries.id}`}>{blogEntries.data.title}</a>
							</li>
						))
					}
				</ul>
				<h1>{post.data.title}</h1>
				<Content/>
			</div>
		</div>
	</main>
</Layout>
